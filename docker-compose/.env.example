# FaceSDK 环境变量配置模板
# 复制此文件为 .env 并根据实际情况修改

# ============================================
# CompreFace 核心配置
# ============================================

# API 服务端口
COMPREFACE_PORT=8000

# Web UI 端口
COMPREFACE_UI_PORT=8001

# API 密钥（用于客户端认证）
# 建议生成强随机字符串: openssl rand -base64 32
COMPREFACE_API_KEY=your-secure-api-key-here

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOGGING_LEVEL=INFO

# 最大请求大小（字节）
MAX_REQUEST_SIZE=10485760

# 最大文件大小（字节）
MAX_FILE_SIZE=10485760

# 工作进程数
WORKERS=4

# 每进程线程数
THREADS=4

# 请求超时时间（秒）
TIMEOUT=120

# 保持连接时间（秒）
KEEP_ALIVE=5

# ============================================
# 数据库配置
# ============================================

# PostgreSQL 端口
POSTGRES_PORT=5432

# 数据库名称
POSTGRES_DB=compreface

# 数据库用户
POSTGRES_USER=compreface

# 数据库密码（生产环境必须修改）
POSTGRES_PASSWORD=your-secure-db-password

# ============================================
# Redis 配置
# ============================================

# Redis 端口
REDIS_PORT=6379

# Redis 最大内存
REDIS_MAXMEMORY=512mb

# ============================================
# MinIO 对象存储配置
# ============================================

# MinIO API 端口
MINIO_API_PORT=9000

# MinIO 控制台端口
MINIO_CONSOLE_PORT=9001

# MinIO 根用户
MINIO_ROOT_USER=minioadmin

# MinIO 根密码（生产环境必须修改）
MINIO_ROOT_PASSWORD=minioadmin123

# ============================================
# Nginx 配置
# ============================================

# HTTP 端口
NGINX_HTTP_PORT=80

# HTTPS 端口
NGINX_HTTPS_PORT=443

# ============================================
# 监控配置
# ============================================

# Prometheus 端口
PROMETHEUS_PORT=9090

# Grafana 端口
GRAFANA_PORT=3000

# Grafana 管理员用户名
GRAFANA_ADMIN_USER=admin

# Grafana 管理员密码（生产环境必须修改）
GRAFANA_ADMIN_PASSWORD=admin

# ============================================
# 资源限制配置
# ============================================

# CPU 限制
CPU_LIMIT=4

# 内存限制
MEMORY_LIMIT=8G

# CPU 预留
CPU_RESERVATION=2

# 内存预留
MEMORY_RESERVATION=4G

# ============================================
# GPU 支持配置（可选）
# ============================================
# 如需启用 GPU 加速，取消 docker-compose.yml 中 GPU 相关注释即可
