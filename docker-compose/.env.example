# Copy to .env and change credentials before starting.
COMPREFACE_BIND_ADDRESS=127.0.0.1
COMPREFACE_PORT=8000
POSTGRES_USER=compreface
POSTGRES_DB=compreface
POSTGRES_PASSWORD=replace-with-a-strong-database-password
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=10MB
WORKERS=2
THREADS=1
CPU_LIMIT=4
MEMORY_LIMIT=8G

# Create Detection, Recognition and Verification services in CompreFace UI.
# These are client/test settings; setting environment variables does not create services.
FACESDK_DETECTION_API_KEY=
FACESDK_RECOGNITION_API_KEY=
FACESDK_VERIFICATION_API_KEY=

# Default object storage: RustFS. Change the password before starting.
RUSTFS_ACCESS_KEY=facesdk
RUSTFS_SECRET_KEY=replace-with-a-strong-object-storage-password
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
# Any S3-compatible OSS: endpoint, bucket, region, credentials and addressing style.
# Empty credentials use the local RustFS credentials above.
OSS_ENDPOINT=http://rustfs:9000
OSS_BUCKET=facesdk-images
OSS_REGION=us-east-1
OSS_ACCESS_KEY_ID=
OSS_SECRET_ACCESS_KEY=
OSS_SESSION_TOKEN=
OSS_ADDRESSING_STYLE=path
OSS_AUTO_CREATE_BUCKET=true
OSS_PREFIX=faces
# Custom CA: mount the certificate read-only into oss-gateway and set its container path.
OSS_CA_BUNDLE=
OSS_MAX_BODY_BYTES=10485760

# Optional profiles: gateway (TLS), monitoring, cache.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
